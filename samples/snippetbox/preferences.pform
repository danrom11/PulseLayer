{
  "format": "pulseui-form",
  "version": 1,
  "title": "Preferences",
  "width": 380,
  "height": 300,
  "root": {
    "type": "VStack",
    "props": {
      "spacing": 14,
      "padding": 22
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "text": "Preferences",
          "font_size": 20,
          "weight": 3
        }
      },
      {
        "type": "Toggle",
        "props": {
          "label": "Dark theme",
          "checked": true,
          "id": "dark"
        },
        "bind": {
          "checked": "store.dark"
        }
      },
      {
        "type": "Toggle",
        "props": {
          "label": "Show line numbers",
          "checked": true,
          "id": "line_numbers"
        },
        "bind": {
          "checked": "store.line_numbers"
        }
      },
      {
        "type": "HStack",
        "props": {
          "align_items": 1
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": "Language of new snippets"
            }
          },
          {
            "type": "Spacer"
          },
          {
            "type": "Select",
            "props": {
              "options": "C++, Python, JavaScript, Shell, Text",
              "index": 0,
              "id": "default_language",
              "width": 130
            },
            "bind": {
              "index": "store.default_language"
            }
          }
        ]
      },
      {
        "type": "Text",
        "props": {
          "text": "Changes apply instantly to every window.",
          "id": "note"
        }
      },
      {
        "type": "Spacer"
      },
      {
        "type": "HStack",
        "children": [
          {
            "type": "Spacer"
          },
          {
            "type": "Button",
            "props": {
              "label": "Done",
              "kind": 1,
              "id": "done",
              "width": 90
            },
            "on": {
              "click": "close"
            }
          }
        ]
      }
    ]
  }
}
